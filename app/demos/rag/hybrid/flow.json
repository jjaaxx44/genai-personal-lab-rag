{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Hybrid Search",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      495
    ],
    "legend": {
      "entries": {
        "emphasis": {
          "label": "question path"
        },
        "default": {
          "label": "ingestion (once per document)"
        },
        "dashed": {
          "label": "index lookup"
        }
      }
    }
  },
  "stages": [
    {
      "label": "Input"
    },
    {
      "label": "Prepare"
    },
    {
      "label": "Embed"
    },
    {
      "label": "Search"
    },
    {
      "label": "Fuse + generate"
    }
  ],
  "nodes": [
    {
      "id": "pdf",
      "type": "frontend",
      "label": "PDF",
      "sublabel": "uploaded document",
      "stage": 0,
      "row": 0,
      "tag": "ingest"
    },
    {
      "id": "split",
      "type": "backend",
      "label": "Extract + split",
      "sublabel": "recursive splitter",
      "stage": 1,
      "row": 0
    },
    {
      "id": "embedDocs",
      "type": "backend",
      "label": "Embed passages",
      "sublabel": "bge-small-en-v1.5",
      "stage": 2,
      "row": 0
    },
    {
      "id": "store",
      "type": "database",
      "label": "rag_hybrid",
      "sublabel": "vector + text index",
      "stage": 3,
      "row": 0,
      "tag": "MongoDB"
    },
    {
      "id": "question",
      "type": "frontend",
      "label": "Question",
      "sublabel": "from the user",
      "stage": 0,
      "row": 1,
      "tag": "query"
    },
    {
      "id": "vectorSearch",
      "type": "backend",
      "label": "Embed + $vectorSearch",
      "sublabel": "bge-small-en-v1.5 query vector",
      "stage": 3,
      "row": 1,
      "width": 190
    },
    {
      "id": "keywordSearch",
      "type": "backend",
      "label": "$search BM25",
      "sublabel": "tokenised terms",
      "stage": 3,
      "row": 2
    },
    {
      "id": "fusion",
      "type": "backend",
      "label": "Weighted RRF",
      "sublabel": "vector_weight, rrf_k",
      "stage": 4,
      "row": 2
    },
    {
      "id": "llm",
      "type": "cloud",
      "label": "Chat model",
      "sublabel": "one call",
      "stage": 4,
      "row": 1
    },
    {
      "id": "answer",
      "type": "frontend",
      "label": "Answer",
      "sublabel": "with page citations",
      "stage": 4,
      "row": 0
    }
  ],
  "flows": [
    {
      "id": "pdf-split",
      "from": "pdf",
      "to": "split",
      "label": "text layer"
    },
    {
      "id": "split-embed",
      "from": "split",
      "to": "embedDocs",
      "label": "passages"
    },
    {
      "id": "embed-store",
      "from": "embedDocs",
      "to": "store",
      "label": "vectors + tokens"
    },
    {
      "id": "question-vector",
      "from": "question",
      "to": "vectorSearch",
      "label": "question text",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "id": "question-keyword",
      "from": "question",
      "to": "keywordSearch",
      "label": "question text"
    },
    {
      "id": "store-vector",
      "from": "store",
      "to": "vectorSearch",
      "label": "nearest by cosine",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 24
    },
    {
      "id": "store-keyword",
      "from": "store",
      "to": "keywordSearch",
      "label": "keyword-index lookup",
      "variant": "dashed",
      "fromSide": "top",
      "toSide": "bottom",
      "via": [[745, 100], [1050, 100], [1050, 430], [745, 430]]
    },
    {
      "id": "vector-fusion",
      "from": "vectorSearch",
      "to": "fusion",
      "label": "ranked list A",
      "variant": "emphasis"
    },
    {
      "id": "keyword-fusion",
      "from": "keywordSearch",
      "to": "fusion",
      "label": "ranked list B",
      "via": [[850, 385], [850, 403], [904, 403]],
      "labelAt": [858, 403]
    },
    {
      "id": "fusion-llm",
      "from": "fusion",
      "to": "llm",
      "label": "fused top-k",
      "variant": "emphasis"
    },
    {
      "id": "llm-answer",
      "from": "llm",
      "to": "answer",
      "label": "grounded reply",
      "variant": "emphasis"
    }
  ]
}
